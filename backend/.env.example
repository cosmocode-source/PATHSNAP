# ==============================================================================
# PathSnap Backend Configuration (.env)
# ==============================================================================

# Folder with the trips to serve.
# Default for development: ../Dataset/student_test.
# On demo day, point this to the evaluator-trips folder.
TRIPS_DIR=../Dataset/student_test

# Path to the model directory.
# The frozen classifier selected in COMPARISON_REPORT.md.
MODEL_DIR=../trained_models/final_model

# Python path of the HMM decoder in format "module.path:function_name".
# Expected signature: decode_trip(candidates, probs, network, gps_xy, times, config) -> {arc_per_point, predicted_route, diagnostics}
# The evaluated adapter; leave blank only for explicit classifier-only operation.
HMM_MODULE=trained_models.hmm.api_adapter:decode_trip

# Frozen settings used in the report. A missing or different path fails startup.
HMM_CONFIG=../trained_models/hmm/config.json

# Demo profile: fail visibly if HMM decoding fails. Set false for a warned classifier-only fallback.
STRICT_HMM=true

# Port on which the FastAPI/Uvicorn server runs.
PORT=8000

# Allowed CORS origins (comma-separated or '*' for dev).
ALLOWED_ORIGINS=*

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Number of worker threads for running CPU-heavy inference jobs.
MAX_WORKERS=1

# Time (in minutes) to retain completed or failed jobs in memory.
JOB_TTL_MINUTES=60

# Per-trip processing timeout in seconds.
TRIP_TIMEOUT_S=120

# Maximum raw GPS points to render in the UI without downsampling.
MAX_DISPLAY_POINTS=1000

# Ngrok auth token (optional; set in environment or paste here locally, NEVER commit).
NGROK_AUTHTOKEN=

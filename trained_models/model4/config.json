{
  "model": "LightGBM",
  "family": "Boosting",
  "seeds": [
    42
  ],
  "table": "raw",
  "features": [
    "dist_m",
    "frac",
    "dist_to_start_m",
    "dist_to_end_m",
    "log_arc_len",
    "rank",
    "dist_minus_nearest",
    "n_candidates",
    "is_nearest",
    "arc_bearing",
    "heading_sin",
    "heading_cos",
    "heading_valid",
    "is_reverse_twin",
    "speed_mps",
    "after_gap",
    "stationary",
    "d_prev_m",
    "d_next_m",
    "mean_dist_win_m",
    "arc_in_deg",
    "arc_out_deg"
  ],
  "n_features": 22,
  "loss_function": "sample-weighted binary log loss (objective='binary')",
  "fit_rows": "train rows with fit_include == True (other CV folds during CV, all folds for the final model)",
  "cv": "5-fold GroupKFold by trip_id, fold ids stored by preprocessing (cleaned_data/model_data/folds.csv)",
  "evaluation": "unweighted; ALL points headline, CLEAN points diagnostic; student-test evaluation only",
  "hyperparameters": {
    "objective": "binary",
    "metric": "binary_logloss",
    "learning_rate": 0.05,
    "num_leaves": 63,
    "min_child_samples": 100,
    "feature_fraction": 0.8,
    "bagging_fraction": 0.8,
    "bagging_freq": 1,
    "lambda_l2": 1.0,
    "verbose": -1,
    "num_threads": 0,
    "max_rounds": 3000,
    "early_stopping_rounds": 100,
    "early_stop_val_share": 0.2,
    "refit_on_all_rows": true,
    "sample_weight": "clean 1.0 / ambiguous 0.5 / far 0.3 (also on the early-stopping validation rows)",
    "seed": 42
  }
}